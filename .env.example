# ---------------------------------------------------------------------------
# Maison WODI Core API — modèle de configuration (aucun secret réel ici)
# ---------------------------------------------------------------------------
APP_NAME="Maison WODI Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Fuseau métier (les dates sont stockées en UTC)
APP_BUSINESS_TIMEZONE=Africa/Abidjan
APP_CURRENCY=XOF

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wodi
DB_USERNAME=postgres
DB_PASSWORD=

# --- Sessions (back-office Angular : cookie HttpOnly) ----------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Production : domaine parent commun au site et à l'API, ex. .maisonwodi.com
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Hôtes du back-office qui reçoivent une session (sans schéma)
SANCTUM_STATEFUL_DOMAINS=localhost:4200,127.0.0.1:4200

# --- CORS : origines autorisées (séparées par des virgules) ----------------
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Jetons mobiles (minutes) -----------------------------------------------
MOBILE_ACCESS_TOKEN_TTL=120
MOBILE_REFRESH_TOKEN_TTL=43200

# --- Liens envoyés par e-mail ---------------------------------------------
# Réinitialisation du mot de passe : {token} est remplacé par le jeton
MOBILE_RESET_PASSWORD_URL="maisonwodi://reset-password?token={token}"
ADMIN_RESET_PASSWORD_URL="http://localhost:4200/admin/reset-password?token={token}"

# --- Reconstruction du site vitrine (webhook appelé après une modification publique)
VITRINE_BUILD_WEBHOOK_URL=
VITRINE_BUILD_WEBHOOK_SECRET=

# --- Notifications push Expo (désactivées tant que non configurées) -------
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

BROADCAST_CONNECTION=log
# Production : s3 possible (voir config/filesystems.php)
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@maisonwodi.com"
MAIL_FROM_NAME="Maison WODI"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Documentation OpenAPI (/api/docs) : désactivée par défaut en production
API_DOCS_ENABLED=true
